{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["*.html"]
      }
    },
    { "src": "imagenes/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/imagenes/(.*)", "dest": "/imagenes/$1" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}

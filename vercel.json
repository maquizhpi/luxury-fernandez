{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["*.html"]
      }
    },
    { "src": "imagenes/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/imagenes/(.*)", "dest": "/imagenes/$1" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
